@startuml context_diagram
left to right direction
skinparam componentStyle rectangle

actor "Players\n(4 clients)" as Players
actor "Match Reviewer" as Reviewer
actor "Server Operator" as Operator
actor "QA / CI" as QA

package "Runtime Environment (Docker container or native process)" {
  rectangle "RAMServer-Core\n(Go process)" as Core
  database "SQLite file\n(embedded)" as DB
  Core -- DB : in-process
}

cloud "GitHub\n(Actions, Projects)" as GH
cloud "Cloud host\n(stretch goal)" as Cloud

Players -- Core : Protobuf over TCP\n(:9000)
Reviewer -- Core : match retrieval request
Operator --> Core : env vars, shutdown signal
Core --> Operator : structured logs (stdout)
QA --> Core : conformance and adversarial tests
GH ..> QA : triggers CI (build time only)
Cloud ..> Core : hosts container (optional)
@enduml