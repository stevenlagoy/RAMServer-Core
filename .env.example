# Copy this file to .env and adjust values as needed. .env is not committed.

# Address the server listens on (host:port).
RAMSERVER_ADDR=127.0.0.1:9000

# Maximum frame payload size in bytes, not counting the 4-byte length prefix.
# Must match on the server and its clients. See docs/framing.md.
RAMSERVER_MAX_FRAME_BYTES=65536
